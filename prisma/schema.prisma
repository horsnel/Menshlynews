generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// PostMeta stores dynamic metadata for articles (likes, views)
// Articles themselves come from src/lib/data.ts — this table ONLY tracks engagement metrics
model PostMeta {
  id        String   @id   // Matches the id in data.ts (e.g., "1", "2", "31")
  likes     Int      @default(0)
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  likeRecords Like[]
}

model Like {
  id          String   @id @default(cuid())
  postId      String   // Matches PostMeta.id / data.ts post id
  fingerprint String
  createdAt   DateTime @default(now())

  post        PostMeta @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, fingerprint])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("popup")   // popup, footer, sidebar
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
